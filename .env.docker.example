# Copy to .env next to docker-compose.yml. Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Generate with:  openssl rand -base64 48
JWT_SECRET=
PORT=4000
CORS_ORIGIN=http://localhost:4000

# First administrator (created once, only if no admin exists). Password: 10+ chars with a letter and a digit.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Debo Admin

# sandbox = simulated payments. live needs Ethio telecom merchant credentials and is not implemented.
TELEBIRR_MODE=sandbox
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
